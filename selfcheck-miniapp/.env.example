# ──────────────────────────────────────────────────────────────
# selfcheck-miniapp — environment configuration
# Copy to .env and fill in. NEVER commit the real .env.
# ──────────────────────────────────────────────────────────────

# --- Core ---
PORT=8080
HOST=0.0.0.0

# Telegram bot token from @BotFather. Required to validate Mini App
# initData (the cryptographic proof of which Telegram user is calling)
# and to run the bot that opens the Mini App.
BOT_TOKEN=

# Public HTTPS URL where the Mini App web build is served.
# This is the URL you set in @BotFather (/setmenubutton or Web App URL).
WEBAPP_URL=https://your-domain.example/

# A random secret used to salt verification-code hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODE_SALT=

# Require ownership verification (email/SMS code) before showing a report.
#   true  = self-check only — the user must prove they own the email/phone.
#   false = direct breach lookup (Have I Been Pwned style), no code step.
# Even with false, results stay at "which breaches + what data types" — actual
# leaked passwords/records are never returned, and phone has no data source.
REQUIRE_VERIFICATION=true

# --- Data sources (all optional; without them the app still runs) ---
# Have I Been Pwned API key (email breach lookups). https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Phone breach lookups have no clean free API. Plug in a LAWFUL provider here
# if you have one. Leave empty to disable phone breach lookups (verification
# still works, the report will just say the data source is not configured).
PHONE_PROVIDER=stub
PHONE_PROVIDER_API_KEY=

# --- Verification delivery ---
# mock  = print the code to the server log (local dev only)
# smtp  = send email codes via SMTP (configure SMTP_* below)
EMAIL_DELIVERY=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# mock   = print the SMS code to the server log (local dev only)
# twilio = send via Twilio (configure TWILIO_* below)
SMS_DELIVERY=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Dev / demo switches (keep ALL of these OFF in production) ---
# Returns clearly-labelled SAMPLE breach data so the UI is testable
# without any API key. Never enable in production.
MOCK_BREACHES=false

# Allows an X-Dev-User header to stand in for Telegram initData, for local
# testing in a normal browser. NEVER enable in production.
ALLOW_DEV_AUTH=false

# When using mock delivery, also return the code in the API response so you
# can test the full flow from a browser. NEVER enable in production.
EXPOSE_DEV_CODE=false
